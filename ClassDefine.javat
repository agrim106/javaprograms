class Person{
	String name = "agrim";
	String gender = "m";
	int age = 22;
	Person(String name, String gender, int age){
	this.name = name;
	this.gender = gender;
	this.age = age;
}
	@Override 
	public String toString(){

	return "person{name = '"+ name + "' , age " + age + ", gender = '"+ gender + "'}" ;
	}
}



